{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secretmode:protocol:service-signing-keyset:v1",
  "title": "SecretMode Root-Signed Service Signing Keyset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "keysetVersion",
    "rootKeyId",
    "issuedAtMs",
    "expiresAtMs",
    "keys",
    "rootSignatureB64u"
  ],
  "properties": {
    "type": { "const": "service_signing_keyset" },
    "version": { "const": 1 },
    "keysetVersion": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "rootKeyId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "issuedAtMs": { "type": "integer", "minimum": 0 },
    "expiresAtMs": { "type": "integer", "minimum": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "scope",
          "publicKeySpkiB64u",
          "validFromMs",
          "validUntilMs",
          "status",
          "disabledAtMs"
        ],
        "properties": {
          "keyId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "algorithm": { "const": "P256_SHA256_ECDSA" },
          "scope": { "enum": ["STATE_EVENT", "LEASE"] },
          "publicKeySpkiB64u": {
            "type": "string",
            "minLength": 16,
            "maxLength": 1366,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "validFromMs": { "type": "integer", "minimum": 0 },
          "validUntilMs": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["ACTIVE", "RETIRED", "REVOKED"] },
          "disabledAtMs": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "rootSignatureB64u": {
      "type": "string",
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
