{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secretmode:protocol:signed-lease:v1",
  "title": "SecretMode Signed Session Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "leaseId",
    "sessionId",
    "holderDeviceId",
    "stateVersion",
    "issuedAt",
    "expiresAt",
    "nonce",
    "signingKeyId",
    "signature"
  ],
  "properties": {
    "version": { "const": 1 },
    "leaseId": { "type": "string", "minLength": 16, "maxLength": 256 },
    "sessionId": { "type": "string", "minLength": 16, "maxLength": 256 },
    "holderDeviceId": { "type": "string", "minLength": 16, "maxLength": 256 },
    "stateVersion": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signingKeyId": { "type": "string", "minLength": 8, "maxLength": 256 },
    "signature": {
      "type": "string",
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
