{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretmode.invalid/protocol/pairing-confirm.schema.json",
  "title": "SecretMode Pairing Confirm v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "pairingIdB64u", "transcriptDigestB64u", "inviterSignatureDerB64u"],
  "properties": {
    "type": { "const": "pairing_confirm" },
    "version": { "const": 1 },
    "pairingIdB64u": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "transcriptDigestB64u": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "inviterSignatureDerB64u": { "type": "string", "pattern": "^[A-Za-z0-9_-]{64,160}$" }
  }
}
